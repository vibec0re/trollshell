// Frosted-glass blur for trollshell's translucent chrome surfaces.
//
// Requires niri >= 26.04 (the `ext-background-effect` protocol / layer-rule
// `background-effect` block). niri does NOT support `include`, so merge each
// `layer-rule { }` block below into ~/.config/niri/config.kdl by hand
// (see the "Frosted-glass blur" section in etc/niri/README.md).
//
// IMPORTANT: blur only shows THROUGH a translucent surface. These rules are
// paired with `@shell_background` carrying an alpha < 1 in
// assets/trollshell/style.css — over an opaque surface the blur is invisible.
//
// CLIENT-SIDE REGION SCOPING (niri >= 26.04): these layer-rules frost the WHOLE
// surface geometry, not the painted content. trollshell additionally scopes the
// frost to the visible card via ext-background-effect-v1 `set_blur_region` (the
// `hytte-blur` crate, #192/#193) — so the sidebar/drawer frost hugs the card and
// no strip lingers when closed. KEEP these blocks: they ENABLE blur per
// namespace (the client region only NARROWS it), and they're the un-scoped
// fallback on niri < 26.04 where the client scoping is a graceful no-op.
//
// `match namespace=` is a regex matched anywhere in the surface namespace:
//   hytte-bar-{edge}    -> the bar              (crates/hytte-ui/src/bar.rs:106)
//   hytte-sidebar-{id}  -> the pushable sidebar (overlays/sidebar.rs:218)
//   hytte-modal-{id}    -> the slide-out drawer (modal.rs:449)
//
// DELIBERATELY NOT BLURRED (fullscreen surfaces — blurring them frosts the
// WHOLE screen):
//   hytte-frame         -> fullscreen click-through frame overlay
//   hytte-popup-catcher -> invisible fullscreen dismiss catcher
//
// `xray true` blurs the wallpaper only (cheap, computed once) — used on ALL
// these surfaces so the bar/sidebar/drawer share one consistent dark frost.
// (Frosting the bright window behind an overlay, via `xray false`, makes it
// read brighter and off-colour next to the bar.) Drop `xray true` on a rule
// for a pricier blur that frosts the actual window behind that surface.

layer-rule {
    match namespace="hytte-bar"
    // Full-width flush strip — no rounding.
    geometry-corner-radius 0
    background-effect {
        blur true
        xray true
    }
}

layer-rule {
    match namespace="hytte-sidebar"
    // Flush left panel; the frame overlay paints the rounded inner corner.
    // xray true to match the bar: frost the wallpaper (not the bright window
    // behind it) so the sidebar reads as a consistent dark extension of the
    // bar rather than a brighter, differently-tinted panel.
    geometry-corner-radius 0
    background-effect {
        blur true
        xray true
    }
}

layer-rule {
    match namespace="hytte-modal"
    // Slide-out drawer card. Tune to match the drawer's drawn corner radius.
    // xray true: match the bar/sidebar for one consistent dark frost.
    geometry-corner-radius 14
    background-effect {
        blur true
        xray true
    }
}
