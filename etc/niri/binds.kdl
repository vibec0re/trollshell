// niri media-key bindings for trollshell — see ./README.md
//
// Drop this `binds { … }` block into ~/.config/niri/config.kdl, or merge the
// individual binding lines into your existing `binds { }` block. niri has no
// `include` directive, so a copy is required either way.
//
// External tools: wpctl (wireplumber), brightnessctl, playerctl. The
// trollshell pipewire and brightness services pick up the resulting state
// changes via their own listeners (pactl subscribe / inotify on sysfs), so
// the OSD reacts automatically — no D-Bus call back into trollshell needed.

binds {
    // Volume — repeat while held so the user can ramp; -l 1.5 caps the boost
    // at 150 % to keep the speaker driver out of distortion / damage range.
    // Not allow-when-locked: surprise volume jumps through a locked screen
    // are unfriendly.
    XF86AudioRaiseVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+" "-l" "1.5"; }
    XF86AudioLowerVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }

    // Mute — single-fire, allowed from the lock screen so you can silence a
    // surprise notification sound without unlocking.
    XF86AudioMute     allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@"   "toggle"; }
    XF86AudioMicMute  allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }

    // Brightness — repeat while held. Not allow-when-locked: same reasoning
    // as volume, plus a fully bright lock screen is a privacy footgun.
    XF86MonBrightnessUp   { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown { spawn "brightnessctl" "set" "5%-"; }

    // Media transport — single-fire, controllable from the lock screen so
    // music can be paused / skipped without unlocking.
    XF86AudioPlay  allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext  allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev  allow-when-locked=true { spawn "playerctl" "previous"; }

    // App launcher (#32) — fuzzel reads .desktop files from XDG_DATA_DIRS,
    // so flatpak / system / user-installed apps surface automatically.
    // Mod+D mirrors the dmenu convention and matches niri's own default
    // config. If you prefer Mod+Space, swap the chord here — note that
    // niri's default config comments Mod+Space out, but some users bind
    // it to switch-layout, so a conflict is on you to resolve.
    Mod+D hotkey-overlay-title="Run an Application: fuzzel" { spawn "fuzzel"; }

    // Clipboard history (#729) — opens the drawer straight to the
    // Clipboard page via the shell's own `open-page` org.gtk.Actions verb
    // (#219; trollshell/src/commands.rs), no custom IPC needed. busctl
    // talks to trollshell's existing session-bus name; see
    // etc/cliphist/README.md for the full recipe and a manual busctl
    // one-liner to test the verb without this keybind.
    Mod+V hotkey-overlay-title="Open Clipboard History" { spawn "busctl" "--user" "call" "mov.vibec0re.trollshell" "/mov/vibec0re/trollshell" "org.gtk.Actions" "Activate" "sava{sv}" "open-page" "1" "s" "clipboard" "0"; }

    // Workspaces page (#1071 phase 1, #1108) — no bar chip (Annika dropped it
    // on #1108: "the chip can be dropped"), so this is the only way to reach
    // it besides Settings → More → Workspaces. Commented out — pick your own
    // chord and uncomment; the same `open-page` verb as the clipboard bind
    // above, just a different page token.
    // Mod+W hotkey-overlay-title="Open Workspaces" { spawn "busctl" "--user" "call" "mov.vibec0re.trollshell" "/mov/vibec0re/trollshell" "org.gtk.Actions" "Activate" "sava{sv}" "open-page" "1" "s" "workspaces" "0"; }

    // Sidebars (#219 verbs; the right one is #1158/#1160). Both are the same
    // `org.gtk.Actions` shape as the clipboard bind above, just parameterless
    // verbs — `toggle-sidebar` flips the left sidebar (the one with the bar
    // chip, so a keybind is a convenience there), `toggle-sidebar-right` the
    // right one, which has NO chip and is otherwise unreachable without a mouse
    // on a layer surface that may not even be mapped.
    //
    // Commented out, like the workspaces bind above and for the same reason
    // README.md gives: which chord maps to which verb is a deployer preference,
    // and niri treats a duplicate chord as a hard config error rather than
    // last-wins. Pick your own pair and uncomment — Mod+A / Mod+Shift+A below is
    // a suggestion, not a default, and neither is bound by niri 26.04's stock
    // config.
    //
    // A `toggle-sidebar-right` on an output whose right sidebar has no plugin
    // card mounted does nothing at all (one `debug!` line in the shell's log);
    // that is the epic's "hidden entirely when empty" rule, not a broken bind.
    // Mod+A hotkey-overlay-title="Toggle Sidebar" { spawn "busctl" "--user" "call" "mov.vibec0re.trollshell" "/mov/vibec0re/trollshell" "org.gtk.Actions" "Activate" "sava{sv}" "toggle-sidebar" "0" "0"; }
    // Mod+Shift+A hotkey-overlay-title="Toggle Right Sidebar" { spawn "busctl" "--user" "call" "mov.vibec0re.trollshell" "/mov/vibec0re/trollshell" "org.gtk.Actions" "Activate" "sava{sv}" "toggle-sidebar-right" "0" "0"; }

    // Control Center (#1304) — starts the trollshell-control-center companion
    // app, or focuses it if it's already running (the desktop-entry launch
    // route activates the existing unique-application-id instance rather than
    // opening a twin); the same `open-control-center` verb the gear page's
    // "Control Center" row uses (commands.rs). Same shape and same reason as
    // the sidebar binds above: commented out, pick your own chord.
    // Mod+C hotkey-overlay-title="Open Control Center" { spawn "busctl" "--user" "call" "mov.vibec0re.trollshell" "/mov/vibec0re/trollshell" "org.gtk.Actions" "Activate" "sava{sv}" "open-control-center" "0" "0"; }

    // Column layouts (#1019) — the same binary that paints the bar chip also
    // applies one layout and exits, so these are plain `spawn`s with no shell,
    // no D-Bus and no running plugin involved: it reads $NIRI_SOCKET itself.
    // Counts are COLUMNS, not windows (a stacked column has one width).
    //
    // Mod+Alt is used by nothing in niri 26.04's default config, so these three
    // are safe to merge into a stock `binds { }` block. That is worth checking
    // before you change them: niri treats a duplicate chord as a **hard config
    // error** ("duplicate keybind later defined here") rather than last-wins, so
    // a colliding chord costs you the whole config, not just the bind. Mod+Shift+E
    // in particular is niri's stock `quit`.
    Mod+Alt+E hotkey-overlay-title="Layout: equal columns" { spawn "hytte-plugin-niri-layouts" "apply" "equal"; }
    Mod+Alt+G hotkey-overlay-title="Layout: golden" { spawn "hytte-plugin-niri-layouts" "apply" "golden"; }
    Mod+Alt+S hotkey-overlay-title="Layout: split" { spawn "hytte-plugin-niri-layouts" "apply" "split"; }
}
