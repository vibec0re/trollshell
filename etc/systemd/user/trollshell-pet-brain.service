# The pet's brain: a local llama-server (from nixpkgs' `llama-cpp`) holding a
# small chat model resident. The pet plugin is a thin HTTP client to this —
# the shell's daemon-as-state-store stance applied to a cat.
#
# Fetch the model once (≈0.8 GB, Q4):
#   mkdir -p ~/.local/share/trollshell-pet
#   curl -L -o ~/.local/share/trollshell-pet/brain.gguf \
#     'https://huggingface.co/openbmb/MiniCPM5-1B-GGUF/resolve/main/MiniCPM5-1B-Q4_K_M.gguf'
# (Any chat-tuned GGUF works; the pet only sends /v1/chat/completions.)
[Unit]
Description=llama-server brain for the trollshell pet plugin
PartOf=niri-session.target
After=graphical-session.target

[Service]
Type=simple
# `llama-server` comes from the llama-cpp package. systemd user units don't
# see your shell's PATH: on NixOS, either install llama-cpp system-wide and
# use the absolute /run/current-system/sw/bin/llama-server, or keep the
# /usr/bin/env form below (env resolves via the user manager's PATH, which
# NixOS points at the system + per-user profiles).
ExecStart=/usr/bin/env llama-server --model %h/.local/share/trollshell-pet/brain.gguf --port 8080 --ctx-size 1024 --threads 4
Restart=on-failure
RestartSec=5

[Install]
WantedBy=niri-session.target
