[Unit]
Description=trollshell kaomoji pet plugin (out-of-process, #276)
Documentation=file://%h/.config/systemd/user/README.md
PartOf=niri-session.target
Requisite=graphical-session.target
After=graphical-session.target trollshell.service
# The pet mounts SidebarTop alongside the reference clock demo. Since #274 that
# mount is a *region* holding N plugin cards (sorted by manifest `order`), so
# the two coexist — no `Conflicts=` needed. Enable both if you like.

[Service]
Type=simple
ExecStart=/usr/local/bin/hytte-plugin-pet
# The pet's persona name and its brain. Default brain: OpenRouter (a cloud
# LLM) — drop a key in ~/.config/trollshell/openrouter.key (never in git or
# this unit; it's read via hytte-ai-providers::load_key) and pick a model.
Environment=PET_NAME=nisse
# Desktop owner's name, session-wide (read via hytte_ai_providers::owner by
# both this plugin and caw). Managed declaratively by
# programs.trollshell.ownerName under Nix; set it here directly on the
# non-Nix path. Leave unset for the neutral "your human" fallback.
#   Environment=TROLLSHELL_OWNER=Jordan
# A small, cheap chat model. OpenRouter's `:free` variants are gated (they need
# a privacy opt-in / are heavily rate-limited), so the default is a paid one —
# the pet calls it at most once per 15s, so it's pennies. Swap freely.
Environment=PET_LLM_MODEL=google/gemini-3.5-flash
# Local llama-server instead of OpenRouter: set the base URL (see
# trollshell-pet-brain.service). Leave it empty — Environment=PET_LLM_URL= —
# for a fully canned-line pet. (PET_LLM_API_KEY overrides the key file.)
#   Environment=PET_LLM_URL=http://127.0.0.1:8080
# Call tuning, whole seconds; unset/blank/unparsable/0 keeps the default.
# PET_LLM_MIN_GAP_SECS (15) throttles real model calls; PET_LLM_TIMEOUT_SECS
# (10) bounds one call. A slow backend — a cold claude-bridge turn, a big
# local model — needs the timeout raised FIRST, and any backend-side budget
# (e.g. CLAUDE_BRIDGE_TIMEOUT_SECS) kept strictly below it.
#   Environment=PET_LLM_MIN_GAP_SECS=15
#   Environment=PET_LLM_TIMEOUT_SECS=30
Restart=on-failure
RestartSec=2

[Install]
WantedBy=niri-session.target
