[Unit]
Description=trollshell pomodoro / kitchen timer plugin (out-of-process, #406)
Documentation=file://%h/.config/systemd/user/README.md
PartOf=niri-session.target
Requisite=graphical-session.target
After=graphical-session.target trollshell.service
# Unlike the other bundled plugins, this one mounts BarRight — a bar chip (a
# seven-segment MM:SS readout), not a sidebar card — so there's no region to
# coexist in and no Conflicts= to worry about. Clicking the chip opens its own
# drawer panel (entry + presets + pause/reset). At zero it posts one toast via
# Effect::Notify through trollshell's own notification path — no extra unit or
# D-Bus setup needed. No environment variables to set.

[Service]
Type=simple
ExecStart=/usr/local/bin/hytte-plugin-timer
Restart=on-failure
RestartSec=2

[Install]
WantedBy=niri-session.target
