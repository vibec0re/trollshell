[Unit]
Description=trollshell infobroker — the consent-gated data broker for local AI agents (out-of-process plugin, #487)
Documentation=file://%h/.config/systemd/user/README.md
PartOf=niri-session.target
Requisite=graphical-session.target
After=graphical-session.target trollshell.service
# Mounts BarRight — a bar chip (a shield; a warning triangle + badge when an
# agent is knocking), not a sidebar card, so there's no region to coexist in and
# no Conflicts= to worry about. Clicking the chip opens its own drawer panel
# (grants + revoke, pending + allow, datasource status, sessions, audit trail).
#
# It ALSO binds its own socket, $XDG_RUNTIME_DIR/hytte-infobroker.sock (0600),
# which the `hytte-infobroker` CLI dials — that's how a local agent auths and
# fetches scoped data. Durable grants live in $XDG_STATE_HOME/hytte-infobroker/grants.toml
# (or ~/.local/state/…); session tokens are in-memory only (12 h TTL, killed by a
# panel revoke or this unit / trollshell restarting). See etc/skills/infobroker/
# for the agent-facing skill folder. No environment variables to set.

[Service]
Type=simple
ExecStart=/usr/local/bin/hytte-plugin-infobroker
Restart=on-failure
RestartSec=2

[Install]
WantedBy=niri-session.target
