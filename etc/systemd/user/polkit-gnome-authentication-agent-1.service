[Unit]
Description=polkit-gnome authentication agent
Documentation=https://gitlab.gnome.org/Archive/policykit-gnome
PartOf=niri-session.target
Requisite=graphical-session.target
After=graphical-session.target

[Service]
# Arch installs the agent here. Other distros differ — Fedora/openSUSE use
# /usr/libexec/polkit-gnome/..., Debian/Ubuntu /usr/lib/policykit-1-gnome/...;
# adjust ExecStart to match, or point it at mate-polkit / hyprpolkitagent.
Type=simple
ExecStart=/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
Restart=on-failure
RestartSec=1
TimeoutStopSec=10

[Install]
WantedBy=niri-session.target
