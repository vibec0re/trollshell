# The Claude bridge (#584): a keyless, loopback-only OpenAI-compatible shim in
# front of headless Claude Code (`claude --print`), so the LLM-backed plugins
# can ride a Claude Code subscription with NO change to pet or caw —
# `hytte_ai_providers::Provider` is already just a base URL, so pointing a
# plugin at http://127.0.0.1:8787 is the whole integration.
#
# Prerequisites: the `claude` CLI on the user manager's PATH, already logged in
# (`claude` → `/login`). The bridge holds no credentials of its own — with one
# exception, CLAUDE_BRIDGE_MODE=api (#730), which swaps the subscription for a
# metered API key and needs neither the CLI nor a login. See the api-mode block
# at the bottom of this file.
#
# Port 8787, not 8080 — 8080 belongs to trollshell-pet-brain.service's
# llama-server, and the two are meant to be swappable, not exclusive.
[Unit]
Description=Keyless loopback OpenAI-compatible bridge to headless Claude Code (#584)
Documentation=file://%h/.config/systemd/user/README.md
PartOf=niri-session.target
After=graphical-session.target

[Service]
Type=simple
# Hand-installed path, matching the other static units here. Under the nix
# module path this is `lib.getExe trollshell.packages.<system>.hytte-claude-bridge`
# instead.
ExecStart=/usr/local/bin/hytte-claude-bridge
Environment=RUST_LOG=hytte_claude_bridge=info

# ── SECURITY CONTROL — do not drop this line ─────────────────────────────────
# These four would silently move `claude` off the subscription and onto metered
# API credits (or Bedrock/Vertex), with nothing in the UI to show for it. The
# bridge cannot scrub them itself: `std::env::remove_var` is unsafe under
# edition 2024 and this workspace forbids unsafe, and hive-claude's `Config`
# exposes no environment hook. So the scrub happens HERE, and the bridge
# **refuses to start** if it finds any of them still set — belt and braces, and
# a loud failure rather than a quiet bill.
#
# The startup refusal is mode-scoped (#730): it guards the `claude` CHILD, and
# CLAUDE_BRIDGE_MODE=api spawns none, so there ANTHROPIC_API_KEY is the
# credential rather than the offence. The scrub below is NOT mode-scoped —
# `UnsetEnvironment=` is static per-unit — and that is the deliberate call
# (#752): an inherited key that quietly starts billing is a worse failure than
# a mode that has to read its key from a file. See the api-mode block below for
# where that key goes.
UnsetEnvironment=ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX

# The dummy key. Belt-and-braces on THIS unit — nothing in the bridge reads it
# (the bridge is keyless and validates no bearer at all). The copy that actually
# prevents a leak is the one on the CONSUMING plugin's unit, because
# `hytte_ai_providers::load_key` runs in the plugin process: it checks the
# `OPENROUTER_API_KEY` env override BEFORE ~/.config/trollshell/openrouter.key,
# so without the override a pet pointed at this bridge would ship the real
# OpenRouter key to a loopback port. See the opt-in block below.
Environment=OPENROUTER_API_KEY=local-bridge

Restart=on-failure
RestartSec=5

# ── Opting a plugin in ───────────────────────────────────────────────────────
# Nothing here reaches into pet or caw. To point one at the bridge, add to ITS
# unit (e.g. trollshell-plugin-pet.service):
#
#   Environment=PET_LLM_URL=http://127.0.0.1:8787
#   Environment=OPENROUTER_API_KEY=local-bridge   # keeps the real key at home
#
# Other knobs, all optional, all on THIS unit:
#
#   Environment=CLAUDE_BRIDGE_MODE=reprompt   # default: subscription. One of:
#       #   subscription — one persisted `claude` session per conversation
#       #   reprompt     — a one-off `claude --print` per turn, whole record resent
#       #   api          — no `claude` child at all: POST /v1/messages with an
#       #                  Anthropic API key, billed per token (#730). See below.
#   Environment=CLAUDE_BRIDGE_MODEL=claude-haiku-4-5
#       # default: claude's own — except in api mode, which needs an explicit id
#       # and falls back to claude-opus-5.
#   Environment=CLAUDE_BRIDGE_THINKING=disabled
#       # api mode only; one of disabled (default) | adaptive | auto. `disabled`
#       # is load-bearing: max_tokens bounds thinking PLUS answer text, and the
#       # consumers here ask for ~256 tokens of kaomoji. Use `auto` on a model
#       # that rejects an explicit disabled (Fable 5).
#   Environment=CLAUDE_BRIDGE_TIMEOUT_SECS=8           # must stay under 10
#   Environment=CLAUDE_BRIDGE_PORT=8787
#   Environment=CLAUDE_BRIDGE_STATE_DIR=%h/.local/state/hytte-claude-bridge
#       # Two things live here. The `claude` modes run the child with this as
#       # its cwd, which is what scopes claude's on-disk sessions; api mode
#       # spawns no child and ignores that half. All three read
#       # retired-sessions.json — the map of "this conversation's session
#       # overflowed, it continues as this other title" — so a restart resumes
#       # an already-rotated conversation where it left off instead of
#       # replaying the overflow as one failed turn (#855). Only the
#       # subscription mode ever rotates, so only it writes that file, and
#       # deleting it costs at most one failed turn per rotated conversation.

# ── CLAUDE_BRIDGE_MODE=api: the key goes in a FILE, not the environment ───────
# api mode holds a real Anthropic API key and bills metered credits, so it is
# the one mode where reaching the loopback port spends money. Put the key in
#
#   ~/.config/trollshell/anthropic.key        # chmod 600; trimmed, empty == unset
#
# — the same convention `hytte_ai_providers::load_key` uses for the other
# providers, and honoured via $XDG_CONFIG_HOME when that is set.
#
# Do NOT add `Environment=ANTHROPIC_API_KEY=…` here. The bridge does read that
# variable, and it outranks the file, but the SECURITY CONTROL block above
# strips it from this unit on purpose, so setting it here is a no-op: the
# bridge starts, finds no key, and refuses (#752). The env override is for
# `cargo run`, not for systemd.
#
# With no key at all, api mode refuses to start rather than binding 8787 and
# answering every request with a 502 — check `systemctl --user status
# trollshell-claude-bridge` for the refusal, which names this path.

[Install]
WantedBy=niri-session.target
